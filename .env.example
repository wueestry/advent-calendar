# Application environment. Set to `production` to enforce safe defaults.
APP_ENV=development

# Flask secret key for signing session cookies.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production

# Login credentials. For production, prefer APP_PASSWORD_HASH over APP_PASSWORD.
APP_USERNAME=admin
APP_PASSWORD=advent2026
# APP_PASSWORD_HASH=scrypt:32768:8:1$...

# Set to True to unlock all 24 doors regardless of the current date
ENABLE_DEBUG=False

# Target year for December 1-24 unlock dates
CALENDAR_YEAR=2026

# Timezone used to evaluate today's date
TIMEZONE=Europe/Zurich

# Session hardening
COOKIE_SECURE=False
SESSION_LIFETIME_HOURS=12
SESSION_IDLE_TIMEOUT_MINUTES=30

# Login throttling (per application process)
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# CORS: empty means the app does not emit any CORS headers (recommended).
# Comma-separated allowlist for trusted front-end origins, e.g. https://example.com
ALLOWED_ORIGINS=

# Send CSP as report-only instead of enforcing it (only for debugging).
CSP_REPORT_ONLY=False

# Trust X-Forwarded-* headers from exactly one reverse proxy in front of the app.
TRUST_PROXY_HEADERS=False

# Optional host allowlist (comma-separated), e.g. calendar.example.com
TRUSTED_HOSTS=
